{
  "tomodachi": [
    {
      "text": "マイクを置いて抜け出した終電前のバス停",
      "startMs": 13700,
      "endMs": 18800
    },
    {
      "text": "押し込んだ言葉のせいでカバンは重たいままだ",
      "startMs": 18800,
      "endMs": 25400
    },
    {
      "text": "歌い疲れた君の掠れた笑い声が響く",
      "startMs": 25400,
      "endMs": 31400
    },
    {
      "text": "ネオンに隠された星を一緒に探した",
      "startMs": 31400,
      "endMs": 37300
    },
    {
      "text": "「ただの友達」という名前の頑丈な檻の中で",
      "startMs": 37300,
      "endMs": 42000
    },
    {
      "text": "震えるこの手をポケットの奥に隠している",
      "startMs": 42000,
      "endMs": 44900
    },
    {
      "text": "足元を通り過ぎた名もなき野良猫は",
      "startMs": 44900,
      "endMs": 47900
    },
    {
      "text": "誰のルールも知らずに夜を歩く",
      "startMs": 47900,
      "endMs": 50100
    },
    {
      "text": "綺麗事じゃ誤魔化せない泥だらけの心で",
      "startMs": 50100,
      "endMs": 54300
    },
    {
      "text": "君の隣にいる今だけが僕の全てだ",
      "startMs": 54300,
      "endMs": 60600
    },
    {
      "text": "決して届かない距離触れてはいけない体温",
      "startMs": 60600,
      "endMs": 67100
    },
    {
      "text": "それでも刻んだ足跡は確かにここにある",
      "startMs": 67100,
      "endMs": 73100
    },
    {
      "text": "バスが来るヘッドライトが",
      "startMs": 73100,
      "endMs": 91100
    },
    {
      "text": "僕らの影を長くひとつに繋ぐ",
      "startMs": 91100,
      "endMs": 97900
    },
    {
      "text": "明日になればまた同じ笑顔で会えるのかな",
      "startMs": 97900,
      "endMs": 106300
    },
    {
      "text": "嫌だ終わらせたくない",
      "startMs": 106300,
      "endMs": 108800
    },
    {
      "text": "友達のままじゃ息ができないよ",
      "startMs": 108800,
      "endMs": 115600
    },
    {
      "text": "綺麗事じゃ誤魔化せない泥だらけの心で",
      "startMs": 115600,
      "endMs": 122800
    },
    {
      "text": "君の手を強く握った震えが伝わっていく",
      "startMs": 122800,
      "endMs": 129000
    },
    {
      "text": "決して届かない距離今、踏み越えていくんだ",
      "startMs": 129000,
      "endMs": 137600
    },
    {
      "text": "愚かでいいこの足跡を星の代わりにしよう",
      "startMs": 137600,
      "endMs": 141600
    }
  ],
  "shuuden": [
    {
      "text": "薄暗い路地裏のカラオケボックス",
      "startMs": 12700,
      "endMs": 19400
    },
    {
      "text": "いつもの仲間たちの笑い声が響く",
      "startMs": 19400,
      "endMs": 25500
    },
    {
      "text": "グラスの結露が机に星を作って",
      "startMs": 25500,
      "endMs": 32000
    },
    {
      "text": "誰も気付かない弱さをそっと隠した",
      "startMs": 32000,
      "endMs": 39200
    },
    {
      "text": "君がマイクを握って歌い出したあの曲",
      "startMs": 39200,
      "endMs": 42300
    },
    {
      "text": "僕だけに向けられた視線に胸が痛む",
      "startMs": 42300,
      "endMs": 45000
    },
    {
      "text": "友達という名の安全なカバンの中に",
      "startMs": 45000,
      "endMs": 48200
    },
    {
      "text": "しまいきれない想いが溢れ出しそうなんだ",
      "startMs": 48200,
      "endMs": 51500
    },
    {
      "text": "叫べ僕らの声にならない夜を",
      "startMs": 51500,
      "endMs": 57200
    },
    {
      "text": "汚れた足跡さえ肯定してくれるように",
      "startMs": 57200,
      "endMs": 64000
    },
    {
      "text": "都内の片隅で見つけた小さな光",
      "startMs": 64000,
      "endMs": 69900
    },
    {
      "text": "禁断の恋だとしても君の手を離さない",
      "startMs": 69900,
      "endMs": 90200
    },
    {
      "text": "終電間際のホーム冷たい風が吹き抜ける",
      "startMs": 90200,
      "endMs": 96300
    },
    {
      "text": "「またね」と手を振る君の影が長く伸びていく",
      "startMs": 96300,
      "endMs": 101300
    },
    {
      "text": "バス停のベンチで一人きり見上げた宇宙",
      "startMs": 101300,
      "endMs": 107000
    },
    {
      "text": "僕らの小さな歴史が確かにそこにあった",
      "startMs": 107000,
      "endMs": 112800
    },
    {
      "text": "泥臭くたっていい迷い続けてもいい",
      "startMs": 112800,
      "endMs": 119400
    },
    {
      "text": "君と出会えた奇跡が僕のすべてだから",
      "startMs": 119400,
      "endMs": 125600
    },
    {
      "text": "叫べ僕らの声にならない夜を",
      "startMs": 125600,
      "endMs": 133400
    },
    {
      "text": "汚れた足跡さえ肯定してくれるように",
      "startMs": 133400,
      "endMs": 141700
    },
    {
      "text": "都内の片隅で見つけた小さな光",
      "startMs": 141700,
      "endMs": 147400
    },
    {
      "text": "禁断の恋だとしても君の手を離さない",
      "startMs": 147400,
      "endMs": 155800
    },
    {
      "text": "僕らだけの、光。",
      "startMs": 155800,
      "endMs": 159800
    }
  ],
  "boundary": [
    {
      "text": "始発を待つ仲間の歌声を抜け出して",
      "startMs": 12300,
      "endMs": 17200
    },
    {
      "text": "午前二時の路地裏君とふたり駆け抜けた",
      "startMs": 17200,
      "endMs": 23100
    },
    {
      "text": "プラスチックの望遠鏡カバンから取り出して",
      "startMs": 23100,
      "endMs": 29400
    },
    {
      "text": "星を探しにいこうと嘘の言い訳を作った",
      "startMs": 29400,
      "endMs": 35600
    },
    {
      "text": "カンカンと鳴る踏切赤い光が揺れた",
      "startMs": 35600,
      "endMs": 40500
    },
    {
      "text": "ただの友達という見えない境界線の上",
      "startMs": 40500,
      "endMs": 46500
    },
    {
      "text": "踏み越えてしまえば今までが壊れると知ってて",
      "startMs": 46500,
      "endMs": 52400
    },
    {
      "text": "君の横顔から僕は目を逸らせなかった",
      "startMs": 52400,
      "endMs": 57900
    },
    {
      "text": "本当の形を確かめたくて覗き込んだレンズの向こう",
      "startMs": 57900,
      "endMs": 64500
    },
    {
      "text": "ネオンに消された星より君の瞳を探していた",
      "startMs": 64500,
      "endMs": 69700
    },
    {
      "text": "綺麗な友情のままで終わらせるくらいなら",
      "startMs": 69700,
      "endMs": 75300
    },
    {
      "text": "この痛みを抱えたまま夜の果てまで逃げようか",
      "startMs": 75300,
      "endMs": 104800
    },
    {
      "text": "誰かのラブソングを上手に歌う君の",
      "startMs": 104800,
      "endMs": 109600
    },
    {
      "text": "本当の心の奥は誰にもピントが合わない",
      "startMs": 109600,
      "endMs": 116100
    },
    {
      "text": "分け合った缶コーヒー伝わる微かな体温",
      "startMs": 116100,
      "endMs": 121000
    },
    {
      "text": "震えていたのは冬のせいだけじゃないだろ",
      "startMs": 121000,
      "endMs": 127300
    },
    {
      "text": "触れられないものに触れたくて伸ばした手が宙を掻く",
      "startMs": 127300,
      "endMs": 133000
    },
    {
      "text": "僕らが探していたのは星空なんかじゃないんだ",
      "startMs": 133000,
      "endMs": 139000
    },
    {
      "text": "不器用な情熱だけが鼓動を打ち鳴らすから",
      "startMs": 139000,
      "endMs": 144800
    },
    {
      "text": "禁断の恋だとしてもこの衝動はもう誤魔化せない",
      "startMs": 144800,
      "endMs": 148800
    }
  ]
}
